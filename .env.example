# Gemini API (optional for local demo mode). Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# Optional Firestore profile registry. Leave disabled for a fully local starter.
# Set FIRESTORE_ENABLED=true and provide service account JSON as a single-line string.
FIRESTORE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_PLATFORM_COLLECTION=platform_profiles
